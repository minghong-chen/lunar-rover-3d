# Example environment file / 环境变量示例
#
# This project is a fully static front-end scene: it needs NO API keys,
# tokens, or credentials of any kind. These variables only affect the
# bundled development server.
#
# 本项目是纯静态前端场景，不需要任何 API 密钥、令牌或凭据。
# 以下变量仅影响内置开发服务器。
#
# Copy to .env and edit if the defaults clash with something on your machine.
# 如与本机端口冲突，可复制为 .env 后修改。

# Port for `npm start`
PORT=8080

# Bind address. Use 0.0.0.0 to expose on your LAN.
HOST=127.0.0.1

# Optional: port used by the browser smoke test
SMOKE_PORT=8766
